<?xml version="1.0" encoding="UTF-8"?>
<!--
  حداقلی — بدون Rewrite / بدون WebDAV / بدون MimeMap
  تا خطای 500 از خود web.config ندهد.
  API با آدرس مستقیم: /api/index.php?path=...
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="login.html" />
      </files>
    </defaultDocument>
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <fileExtensions>
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
