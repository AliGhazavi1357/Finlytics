<?xml version="1.0" encoding="UTF-8"?>
<!--
  تست استاتیک: این فایل را موقتاً با نام web.config آپلود کنید.
  اگر status.html باز شد، مشکل از HttpPlatform/Python است نه از دامنه.
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Detailed" />
    <defaultDocument>
      <files>
        <clear />
        <add value="status.html" />
      </files>
    </defaultDocument>
    <handlers>
      <clear />
      <add name="StaticFile"
           path="*"
           verb="*"
           modules="StaticFileModule"
           resourceType="Either"
           requireAccess="Read" />
    </handlers>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
